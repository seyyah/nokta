{
    "expo": {
        "name": "Nokta Audit Forge",
        "slug": "nokta-audit-forge",
        "version": "0.1.0",
        "orientation": "portrait",
        "icon": "./assets/icon.png",
        "userInterfaceStyle": "light",
        "splash": {
            "image": "./assets/splash.png",
            "resizeMode": "contain",
            "backgroundColor": "#ffffff"
        },
        "ios": {
            "supportsTabletMode": true
        },
        "android": {
            "adaptiveIcon": {
                "foregroundImage": "./assets/adaptive-icon.png",
                "backgroundColor": "#ffffff"
            }
        },
        "web": {
            "bundler": "metro"
        },
        "plugins": [
            [
                "expo-file-system",
                {
                    "photosPermission": "Allow Nokta to access your photos."
                }
            ]
        ]
    }
}